# ====== Agrega / cambia estas líneas en tu archivo .env ======

APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=divm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file

# ----- Correo (verificación en dos pasos) -----
# Para PROBAR sin correo real deja MAIL_MAILER=log: el código de 6 dígitos aparece en storage/logs/laravel.log
# Para enviar correos reales con Gmail usa estas líneas (la contraseña es una "contraseña de aplicación" NUEVA de Google):
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tucorreo@gmail.com
MAIL_PASSWORD=contraseña_de_aplicacion_de_16_letras
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=tucorreo@gmail.com
MAIL_FROM_NAME="DIVM Educación Especial"

# Pon DOS_PASOS=false si quieres apagar la verificación para todos (por ejemplo, mientras configuras el correo)
DOS_PASOS=true

# ----- Asistente virtual del Informe (Groq) -----
GROQ_API_KEY=pega_aqui_tu_clave_NUEVA
